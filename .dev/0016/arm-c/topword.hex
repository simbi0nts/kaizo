# copyloop @233
4C 39 C1                                          # I62 cmp rcx,r8
0F 83 12 00 00 00                                 # I63 jae copydone
44 8A 14 0D 11 60 41 00                           # I64 mov r10b,[TMP+1+rcx]
44 88 54 08 01                                    # I65 mov [rax+rcx+1],r10b
48 FF C1                                          # I66 inc rcx
EB E5                                             # I67 jmp copyloop
# copydone @260
4A C7 04 CD 00 40 41 00 01 00 00 00               # I68 mov qword[COUNT+r9*8],1
48 FF 04 25 00 60 41 00                           # I69 inc qword[NW]
E9 03 FF FF FF                                    # I70 jmp skip_loop
# done_parse @285
45 31 C0                                          # I71 xor r8d,r8d          (best=0)
49 C7 C2 FF FF FF FF                              # I72 mov r10,-1           (bestidx=-1)
45 31 C9                                          # I73 xor r9d,r9d          (i=0)
# best_loop @298
48 8B 04 25 00 60 41 00                           # I74 mov rax,[NW]
49 39 C1                                          # I75 cmp r9,rax
0F 83 1B 00 00 00                                 # I76 jae best_done
4A 8B 14 CD 00 40 41 00                           # I77 mov rdx,[COUNT+r9*8]
4C 39 C2                                          # I78 cmp rdx,r8
76 06                                             # I79 jbe best_next        (count<=best)
49 89 D0                                          # I80 mov r8,rdx           (best=count)
4D 89 CA                                          # I81 mov r10,r9           (bestidx=i)
# best_next @334
49 FF C1                                          # I82 inc r9
E9 D4 FF FF FF                                    # I83 jmp best_loop
# best_done @342
49 83 FA FF                                       # I84 cmp r10,-1
0F 84 40 00 00 00                                 # I85 je noout             (no words)
4C 89 D0                                          # I86 mov rax,r10
48 6B C0 28                                       # I87 imul rax,rax,40
48 05 00 20 41 00                                 # I88 add rax,0x412000
0F B6 10                                          # I89 movzx edx,byte[rax]  (len)
48 89 C6                                          # I90 mov rsi,rax
48 FF C6                                          # I91 inc rsi              (buf=slot+1)
BF 01 00 00 00                                    # I92 mov edi,1
B8 01 00 00 00                                    # I93 mov eax,1            (write)
0F 05                                             # I94 syscall              write(1,word,len)
C6 04 25 10 60 41 00 0A                           # I95 mov byte[TMP],10     ('\n')
BF 01 00 00 00                                    # I96 mov edi,1
BE 10 60 41 00                                    # I97 mov esi,0x416010
BA 01 00 00 00                                    # I98 mov edx,1
B8 01 00 00 00                                    # I99 mov eax,1
0F 05                                             # I100 syscall             write(1,"\n",1)
# noout @416
31 FF                                             # I101 xor edi,edi
B8 3C 00 00 00                                    # I102 mov eax,60          (exit)
0F 05                                             # I103 syscall             exit(0)
